# ==========================================
# OFONITECH AI ACADEMY - ENVIRONMENT CONFIG
# ==========================================

# Server Port
PORT=3000

# ------------------------------------------
# SUPABASE CONFIGURATION
# Find these in Supabase Dashboard -> Project Settings -> API
# ------------------------------------------
# Project URL (e.g. https://abcdefghijkl.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anon Key (safe for browser and public clients)
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Service Role Key (Keep secret! Only for backend/admin operations)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------
# GITHUB OAUTH CREDENTIALS
# Generated in GitHub Settings -> Developer Settings -> OAuth Apps
# These are entered in Supabase Dashboard -> Authentication -> Providers -> GitHub
# ------------------------------------------
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ------------------------------------------
# FLUTTERWAVE PAYMENT GATEWAY
# Find these in Flutterwave Dashboard -> Settings -> API Keys & Webhooks
# ------------------------------------------
FLUTTERWAVE_PUBLIC_KEY=your_flutterwave_public_key
FLUTTERWAVE_SECRET_KEY=your_flutterwave_secret_key
FLUTTERWAVE_ENCRYPTION_KEY=your_flutterwave_encryption_key

# ------------------------------------------
# MONNIFY PAYMENT GATEWAY
# Find these in Monnify Dashboard -> Settings -> API Keys & Webhooks
# ------------------------------------------
MONNIFY_API_KEY=your_monnify_api_key_here
MONNIFY_SECRET_KEY=your_monnify_secret_key_here
MONNIFY_CONTRACT_CODE=your_monnify_contract_code_here
MONNIFY_BASE_URL=https://sandbox.monnify.com
MONNIFY_WALLET_ACCOUNT_NUMBER=your_wallet_account_number_here

